# Go build stage
FROM registry.access.redhat.com/ubi9/go-toolset:1.26.5@sha256:91d07f2b7f402fe2379fd62eb2fff975c814a595e2ff2988fd7c580568f5f90c AS go-builder

ARG TARGETOS
ARG TARGETARCH
ARG COMMIT_SHA=unknown
ARG BUILD_REF
ARG LDFLAGS="-s -w"

USER root

WORKDIR /workspace

# Copy the Go Modules manifests
COPY go.mod go.mod
COPY go.sum go.sum

# Download dependencies - this layer is cached as long as go.mod/go.sum are unchanged
RUN go mod download

# Copy the go source
COPY apix/     apix/
COPY cmd/      cmd/
COPY internal/ internal/
COPY pkg/      pkg/
COPY version/  version/

RUN go mod download

# Build EPP
ENV CGO_ENABLED=1
ENV GOEXPERIMENT=strictfipsruntime
RUN GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build \
       -ldflags="${LDFLAGS} -X github.com/llm-d/llm-d-router/version.CommitSHA=${COMMIT_SHA} -X github.com/llm-d/llm-d-router/version.BuildRef=${BUILD_REF}" \
       -o bin/epp cmd/epp/main.go

# Runtime stage
FROM registry.redhat.io/ubi9/ubi-minimal-pqc:9.8-1788217333@sha256:3e009398a8aa8eec621393fbf308c5e622f174900e44e8d5fe224c637920924a

WORKDIR /

COPY --from=go-builder /workspace/bin/epp /app/epp

USER 65532:65532

# expose gRPC, health and metrics ports
EXPOSE 9002
EXPOSE 9003
EXPOSE 9090
# expose port for KV-Events ZMQ SUB socket
EXPOSE 5557

ENTRYPOINT ["/app/epp"]

LABEL com.redhat.component="odh-llm-d-inference-scheduler" \
      name="odh-llm-d-inference-scheduler" \
      description="odh-llm-d-inference-scheduler" \
      summary="odh-llm-d-inference-scheduler" \
      io.k8s.display-name="odh-llm-d-inference-scheduler" \
      io.k8s.description="odh-llm-d-inference-scheduler"
